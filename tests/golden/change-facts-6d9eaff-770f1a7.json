 "name": "flowmap",
 "map": [
  {
   "id": "build-the-map",
   "steps": [
    {
     "key": "build-the-map/list-entry-points",
     "name": "Maintainer lists every entry point the repo exposes into inventory.json",
     "endpoints": [
      "CLI flowmap inventory"
     ],
     "evidence": "agreed"
    },
    {
     "key": "build-the-map/check-handlers-are-nodes",
     "name": "Maintainer checks that every entry point's handler is a call-graph node",
     "endpoints": [
      "CLI flowmap callgraph"
     ],
     "evidence": "agreed"
    },
    {
     "key": "build-the-map/write-pass-briefs",
     "name": "Maintainer writes one brief per independent mapping pass (bottom-up or top-down)",
     "endpoints": [
      "CLI flowmap brief"
     ],
     "evidence": "agreed"
    },
    {
     "key": "build-the-map/verify-pass",
     "name": "Agent running a pass checks that every cited anchor exists and every entry point is placed",
     "endpoints": [
      "CLI flowmap verify"
     ],
     "evidence": "agreed"
    },
    {
     "key": "build-the-map/reconcile-passes",
     "name": "Maintainer votes the passes into one map with evidence levels and a list of open questions",
     "endpoints": [
      "CLI flowmap reconcile"
     ],
     "evidence": "agreed"
    }
   ]
  },
  {
   "id": "browse-the-map",
   "steps": [
    {
     "key": "browse-the-map/generate-diagrams",
     "name": "Maintainer generates Mermaid diagrams of the map at system, flow and step zoom",
     "endpoints": [
      "CLI flowmap diagrams"
     ],
     "evidence": "agreed"
    },
    {
     "key": "browse-the-map/build-atlas",
     "name": "Maintainer builds the interactive atlas page and browses flows, steps, merges and code",
     "endpoints": [
      "CLI flowmap atlas"
     ],
     "evidence": "agreed"
    },
    {
     "key": "browse-the-map/draw-canvas",
     "name": "Maintainer draws the map as one left-to-right canvas, or redraws it from an existing atlas page",
     "endpoints": [
      "CLI flowmap canvas"
     ],
     "evidence": "agreed"
    }
   ]
  },
  {
   "id": "review-a-change",
   "steps": [
    {
     "key": "review-a-change/run-lens",
     "name": "Reviewer runs lens on base..head to get the verdict, touched steps, reach and blind spots",
     "endpoints": [
      "CLI flowmap lens"
     ],
     "evidence": "agreed"
    },
    {
     "key": "review-a-change/pull-change-facts",
     "name": "Author pulls the change's deterministic facts as JSON to write the story from",
     "endpoints": [
      "CLI flowmap change"
     ],
     "evidence": "agreed"
    },
    {
     "key": "review-a-change/build-viewer",
     "name": "Maintainer builds the empty hosted viewer page to deploy on a static host",
     "endpoints": [
      "CLI flowmap viewer"
     ],
     "evidence": "agreed"
    }
   ]
  }
 ],
