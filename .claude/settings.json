{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/flowmap-pr-hook",
            "timeout": 120,
            "statusMessage": "flowmap: placing the PR on the map"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/flowmap-pr-hook",
            "timeout": 120,
            "statusMessage": "flowmap: placing the PR on the map"
          }
        ]
      }
    ]
  }
}
